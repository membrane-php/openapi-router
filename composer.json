{
  "name": "membrane/openapi-router",
  "type": "library",
  "license": "MPL-2.0",
  "autoload": {
    "psr-4": {
      "Membrane\\OpenAPIRouter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Membrane\\OpenAPIRouter\\Tests\\": "tests/",
      "Membrane\\OpenAPIRouter\\Tests\\Fixtures\\": "tests/fixtures/"
    }
  },
  "require": {
    "php": "^8.4.0",
    "membrane/openapi-reader": "^3.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^3.0.2",
    "symfony/console": "^7.4.11 || ^8.0.11"
  },
  "require-dev": {
    "infection/infection": "^0.33.2",
    "phpunit/phpunit": "^13.1.11",
    "phpstan/phpstan": "^2.1.55",
    "squizlabs/php_codesniffer": "^4.0.1",
    "guzzlehttp/psr7": "^2.10.1",
    "mikey179/vfsstream": "^1.6.12"
  },
  "bin": [
    "bin/membrane-router"
  ],
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
